# BenchOS API Environment Variables
# Copy to .env for local runs or configure in your PaaS/VPS provider (Railway, Render, Fly.io, Coolify/Hetzner)

SPRING_PROFILES_ACTIVE=prod
PORT=8080

# PostgreSQL 17
DATASOURCE_URL=jdbc:postgresql://localhost:5432/bench-os-db
DATASOURCE_USER=bench_os
DATASOURCE_PASSWORD=change-me-strong-password
DB_POOL_MAX_SIZE=8
DB_POOL_MIN_IDLE=2

# Security (HS256 secret MUST be >= 32 random bytes in production)
JWT_SECRET=change-me-to-a-random-64-char-secret-in-production-environment!
JWT_EXPIRATION=24h
JWT_ISSUER=https://api.benchos.com
CORS_ALLOWED_ORIGINS=https://app.benchos.com

# Public customer tracking page base URL (used in WhatsApp links)
PUBLIC_TRACKING_BASE_URL=https://app.benchos.com/track

# Cloudflare R2 (S3-compatible Object Storage)
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=benchos-media
STORAGE_ACCESS_KEY=change-me-r2-access-key
STORAGE_SECRET_KEY=change-me-r2-secret-key
STORAGE_UPLOAD_URL_TTL=10m
STORAGE_DOWNLOAD_URL_TTL=1h
STORAGE_PATH_STYLE_ACCESS=true

# OpenAPI / Swagger UI (disabled by default in prod profile)
SWAGGER_ENABLED=false

# Transactional Email (Resend API for password reset codes)
MAIL_PROVIDER=resend
MAIL_FROM=BenchOS <onboarding@resend.dev>
RESEND_API_KEY=re_your_api_key_here
MAIL_RESET_CODE_TTL=15m
MAIL_RESEND_COOLDOWN=60s
